<?php
// Local configuration for the Kids That Teach app (do not commit the real config.local.php)
//
// Copy this file to config.local.php and fill in your environment-specific values.

define('DB_HOST', '');
define('DB_NAME', 'mastery_brianrosenthal');
define('DB_USER', '');
define('DB_PASS', '');

// Application branding (used as a fallback; UI will prefer Settings::get('site_title', APP_NAME))
define('APP_NAME', 'Kids That Teach');

// Hostname of the main (admin) site. Every user's site is served at
// {slug}.MAIN_HOST automatically and at /site/{slug}/ on the main host;
// requests on any other hostname are matched against sites.domain (a custom
// domain such as mastery.charlierosenthal.org).
define('MAIN_HOST', 'kidsthatteach.org');

// Former main hostnames. A request on one of these is redirected (301) to the
// same path on MAIN_HOST, so old links keep working. Empty array = none.
define('LEGACY_HOSTS', ['mastery.brianrosenthal.org']);

// Subdomain sites reach this server through a Cloudflare Worker
// (deploy/cloudflare-worker/) that fetches https://MAIN_HOST and passes the
// visitor's hostname in an X-Forwarded-Host header. That header is trusted
// only when the request also carries X-Site-Proxy-Key equal to this value.
// Set the same value as the Worker's PROXY_KEY secret; leave '' to ignore the
// header entirely (subdomains then need a custom-domain entry each).
define('SUBDOMAIN_PROXY_KEY', '');

// A password that signs in as any user — for testing only. Leave empty ('')
// to disable, and disable it in production once testing is done.
define('SUPER_PASSWORD', '');

// SMTP configuration (e.g., Gmail with App Password)
define('SMTP_HOST', 'smtp.gmail.com'); // smtp.gmail.com
define('SMTP_PORT', 587);              // 587 for STARTTLS, 465 for SSL
define('SMTP_USER', '');               // your Gmail address
define('SMTP_PASS', '');               // app password (recommended)
define('SMTP_SECURE', 'tls');          // 'tls' or 'ssl'
define('SMTP_FROM_EMAIL', '');         // often the same as SMTP_USER
define('SMTP_FROM_NAME', 'Kids That Teach');   // From name seen in emails

// HMAC key for remember me tokens (REQUIRED for persistent login).
// Set to a long random string, e.g., bin2hex(random_bytes(32)).
define('REMEMBER_TOKEN_KEY', '');

// ---- Video storage ----
// Videos never touch this server: the browser uploads straight to the bucket
// using a short-lived URL signed by PHP with the secret key below, and the
// public site plays them back through signed URLs (objects stay private).
// Create the bucket and apply CORS from Admin -> Video Storage once these are
// filled in, then click "Test upload" there.
//
// Which provider NEW uploads go to: 'r2' (Cloudflare R2) or 'dreamobjects'.
// Each concept remembers which provider holds its video, so both can be
// configured at once while videos are migrated (deploy/migrate-videos.php).
define('VIDEO_STORAGE_PROVIDER', 'r2');

// Cloudflare R2 (S3-compatible). Dashboard -> R2 Object Storage -> the bucket
// -> Settings shows the "S3 API" URL; paste it as R2_ENDPOINT (with or without
// the trailing /bucket-name). Keys: R2 -> Manage R2 API Tokens -> Create API
// token with "Object Read & Write" on this bucket.
define('R2_ENDPOINT', 'https://<account-id>.r2.cloudflarestorage.com');
define('R2_ACCESS_KEY', '');   // empty = video uploads disabled (when R2 is the active provider)
define('R2_SECRET_KEY', '');
define('R2_VIDEO_BUCKET', 'mastery-videos');
// define('R2_REGION', 'auto');  // default 'auto'; R2 also accepts a jurisdiction such as 'eu'

// DreamHost DreamObjects (Ceph, S3-compatible) — the previous provider. Only
// needed while some videos are still there: playback and the migration read
// from it. Remove once Admin -> Video Storage shows nothing left in it.
// Keys: DreamHost panel -> Cloud Services -> DreamObjects -> Users -> Keys.
define('DREAMOBJECTS_ENDPOINT', 'https://objects-us-east-1.dream.io');
define('DREAMOBJECTS_REGION', 'us-east-1');
define('DREAMOBJECTS_ACCESS_KEY', '');
define('DREAMOBJECTS_SECRET_KEY', '');
define('DREAMOBJECTS_VIDEO_BUCKET', 'mastery-videos'); // bucket names are globally unique

// Largest video a user may upload, in bytes (default 2 GB).
define('VIDEO_MAX_BYTES', 2 * 1024 * 1024 * 1024);

// Playback URLs are signed with a timestamp rounded down to WINDOW seconds
// (so browsers can cache the video) and stay valid for TTL seconds (forced to
// at least 2 x WINDOW, at most 7 days). Defaults: 6 hours / 24 hours.
// define('VIDEO_URL_WINDOW_SECONDS', 21600);
// define('VIDEO_URL_TTL_SECONDS', 86400);
