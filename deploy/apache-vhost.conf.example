# Apache vhost for Kids That Teach on a SELF-MANAGED server (root access).
# The production DreamHost VPS is panel-managed and does not use this file:
# see docs/deployment.md. One DocumentRoot serves every hostname; PHP looks
# at the hostname (SiteResolver) to decide whether to show the admin site or
# a user's site.
#
# 1. Copy to /etc/apache2/sites-available/kidsthatteach.conf, adjust paths/user.
# 2. sudo a2enmod rewrite; sudo a2ensite kidsthatteach; sudo systemctl reload apache2
# 3. Point DNS A records for the hostnames at this server.
# 4. sudo certbot --apache -d kidsthatteach.org -d mastery.brianrosenthal.org \
#        -d mastery.charlierosenthal.org
#    (certbot writes the :443 vhost and the http->https redirect for you.)
#    The *.kidsthatteach.org subdomains arrive via the Cloudflare Worker with
#    Host: kidsthatteach.org, so they need no ServerAlias or certificate here.
#    (A self-managed box could instead take the wildcard itself: add
#    "ServerAlias *.kidsthatteach.org" and a certbot DNS-challenge wildcard
#    cert, and leave SUBDOMAIN_PROXY_KEY empty.)
# 5. When a custom kid domain is added: add it to ServerAlias, re-run certbot
#    with the extra -d, and set the domain in Admin -> Sites (CORS is
#    re-applied automatically; Admin -> Video Storage shows the result).

<VirtualHost *:80>
    ServerName kidsthatteach.org
    ServerAlias mastery.brianrosenthal.org mastery.charlierosenthal.org

    DocumentRoot /home/brosenthvps/mastery.brianrosenthal.org

    <Directory /home/brosenthvps/mastery.brianrosenthal.org>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/kidsthatteach-error.log
    CustomLog ${APACHE_LOG_DIR}/kidsthatteach-access.log combined
</VirtualHost>
